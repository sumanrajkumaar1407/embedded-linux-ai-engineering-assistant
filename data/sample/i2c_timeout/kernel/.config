#
# Embedded Linux Kernel Configuration
#
 
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_PREEMPT=y
 
#
# I2C support
#
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_CORE=y
# CONFIG_I2C_DESIGNWARE_PLATFORM is not set
 
#
# Hardware monitoring
#
CONFIG_HWMON=y
CONFIG_SENSORS_LM75=y
 
#
# GPIO
#
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
 
#
# Device Tree
#
CONFIG_OF=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
 
#
# Clock support
#
CONFIG_COMMON_CLK=y
 
#
# Debugging
#
CONFIG_DEBUG_FS=y
CONFIG_KALLSYMS=y
 
#
# Networking
#
CONFIG_NET=y
CONFIG_INET=y

